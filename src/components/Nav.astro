---
const WA_NUMBER = '56981862444';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20me%20interesa%20consultar%20sobre%20sus%20servicios%20de%20kinesiología.`;
const INSTAGRAM = 'https://www.instagram.com/victorkine_integral/';

const navLinks = [
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#donde-atiendo', label: 'Dónde atiendo' },
  { href: '#contacto', label: 'Contacto' },
];
---

<nav id="navbar">
  <div class="nav-inner">
    <a href="#inicio" class="nav-brand">
      <div class="brand-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a5 5 0 015 5v2a5 5 0 01-10 0V7a5 5 0 015-5z"/>
          <path d="M6.5 13.5C4 15 3 18 3 21h18c0-3-1-6-3.5-7.5"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">Víctor Gallardo</span>
        <span class="brand-title">Kinesiólogo · U. de Chile</span>
      </div>
    </a>

    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href} class="nav-link">{link.label}</a></li>
      ))}
    </ul>

    <div class="nav-actions">
      <a href={INSTAGRAM} target="_blank" rel="noopener" class="nav-ig" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>
      <a href={WA_LINK} target="_blank" rel="noopener" class="nav-cta" id="nav-cta-wa">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Agendar ahora
      </a>
    </div>

    <button class="nav-hamburger" id="hamburger" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <ul>
      {navLinks.map(link => (
        <li><a href={link.href} class="mobile-link">{link.label}</a></li>
      ))}
      <li>
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa" style="margin-top:0.75rem;justify-content:center;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Contactar por WhatsApp
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  nav.scrolled {
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(15,52,96,0.1);
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-icon {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, var(--color-blue-700), var(--color-blue-500));
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }
  .brand-icon svg { width: 22px; height: 22px; }

  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-size: 0.95rem; font-weight: 700; color: var(--color-blue-900); }
  .brand-title { font-size: 0.65rem; font-weight: 500; color: var(--color-accent); letter-spacing: 0.06em; text-transform: uppercase; }

  .nav-links {
    display: flex; align-items: center; gap: 0;
    list-style: none; margin-left: auto;
  }

  .nav-link {
    font-size: 0.875rem; font-weight: 500;
    color: var(--color-gray-600);
    padding: 0.45rem 0.8rem;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
    text-decoration: none;
  }
  .nav-link:hover { color: var(--color-blue-700); background: var(--color-blue-50); }

  .nav-actions { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }

  .nav-ig {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 8px;
    color: var(--color-gray-600);
    transition: color 0.2s, background 0.2s;
  }
  .nav-ig:hover { color: #e1306c; background: #fef0f5; }
  .nav-ig svg { width: 18px; height: 18px; }

  .nav-cta {
    display: inline-flex; align-items: center; gap: 0.45rem;
    background: linear-gradient(135deg, var(--wa-green), var(--wa-dark));
    color: #fff; font-weight: 700; font-size: 0.82rem;
    padding: 0.6rem 1.1rem; border-radius: 50px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 3px 14px rgba(37,211,102,0.3);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37,211,102,0.45); }
  .nav-cta svg { width: 14px; height: 14px; }

  .nav-hamburger {
    display: none; flex-direction: column; gap: 5px;
    background: none; border: none; cursor: pointer; padding: 4px; margin-left: auto;
  }
  .nav-hamburger span {
    display: block; width: 24px; height: 2px;
    background: var(--color-blue-900); border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu {
    display: none; padding: 1rem 1.5rem 1.5rem;
    background: rgba(255,255,255,0.98);
    border-top: 1px solid var(--color-gray-200);
  }
  .mobile-menu.open { display: block; }
  .mobile-menu ul { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }

  .mobile-link {
    display: block; padding: 0.7rem 1rem;
    font-size: 1rem; font-weight: 500; color: var(--color-gray-700);
    border-radius: 8px; transition: background 0.2s, color 0.2s;
    text-decoration: none;
  }
  .mobile-link:hover { background: var(--color-blue-50); color: var(--color-blue-700); }

  @media (max-width: 900px) {
    .nav-links { display: none; }
  }
  @media (max-width: 650px) {
    .nav-actions { display: none; }
    .nav-hamburger { display: flex; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');

  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 40);
  });

  hamburger?.addEventListener('click', () => mobileMenu?.classList.toggle('open'));
  mobileMenu?.querySelectorAll('a').forEach(l => l.addEventListener('click', () => mobileMenu?.classList.remove('open')));
</script>
