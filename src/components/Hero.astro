---
const WA_NUMBER = '56981862444';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20quisiera%20agendar%20una%20consulta%20kinesiológica.`;
---

<section id="inicio" class="hero">
  <div class="hero-bg-shape"></div>
  <div class="hero-bg-dots"></div>

  <div class="container hero-inner">
    <div class="hero-text">
      <div class="hero-badge reveal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Titulado Universidad de Chile · 1983
      </div>

      <h1 class="hero-title reveal">
        Kinesiólogo<br/>
        <em>Integral</em><br/>
        <span class="hero-subtitle-line">a tu servicio</span>
      </h1>

      <p class="hero-desc reveal">
        Más de <strong>40 años de experiencia</strong> en kinesiología musculoesquelética,
        deportiva y estética. Atención personalizada en Santiago con los más altos
        estándares clínicos y humanos.
      </p>

      <div class="hero-ctas reveal">
        <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa" id="cta-wa-hero">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Consultar por WhatsApp
        </a>
        <a href="#servicios" class="btn-outline" id="cta-ver-servicios">
          Ver servicios
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="hero-stats reveal">
        <div class="stat">
          <span class="stat-n">+40</span>
          <span class="stat-l">años de experiencia</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-n">15</span>
          <span class="stat-l">años en Valle Nevado</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-n">5</span>
          <span class="stat-l">comunas de atención</span>
        </div>
      </div>
    </div>

    <div class="hero-photo-col reveal">
      <div class="hero-photo-wrap">
        <img
          src="/victor-gallardo.png"
          alt="Víctor Gallardo, Kinesiólogo Integral — Universidad de Chile"
          class="hero-photo"
        />

        <!-- Floating credential card -->
        <div class="hero-cred">
          <div class="hero-cred-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 013.741-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675"/>
            </svg>
          </div>
          <div>
            <div class="hero-cred-title">Universidad de Chile</div>
            <div class="hero-cred-sub">Kinesiólogo · Titulado 1983</div>
          </div>
        </div>

        <!-- Online indicator -->
        <div class="hero-online">
          <span class="online-dot"></span>
          Disponible para consultas
        </div>
      </div>
    </div>
  </div>

  <!-- Trusted by / feature strip -->
  <div class="hero-strip">
    <div class="container hero-strip-inner">
      <div class="strip-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Atención personalizada
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
        </svg>
        Equipos de última generación
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z"/>
        </svg>
        5 comunas de Santiago
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172"/>
        </svg>
        Deportiva y estética
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 5rem;
    overflow: hidden;
    background: linear-gradient(160deg, #f0f8ff 0%, #e8f4fd 50%, #ffffff 100%);
  }

  .hero-bg-shape {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 65%;
    aspect-ratio: 1;
    background: radial-gradient(ellipse, rgba(25,118,210,0.1) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(25,118,210,0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 460px;
    gap: 3rem;
    align-items: flex-end;
    padding-top: 2rem;
    padding-bottom: 0;
    position: relative;
    z-index: 1;
  }

  /* Text column */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(25,118,210,0.08);
    border: 1px solid rgba(25,118,210,0.2);
    color: var(--color-blue-700);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: 50px;
    margin-bottom: 1.75rem;
    width: fit-content;
  }

  .hero-title {
    font-size: clamp(2.8rem, 5.5vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    color: var(--color-blue-900);
  }

  .hero-title em {
    font-style: italic;
    font-family: var(--font-serif);
    color: var(--color-blue-700);
  }

  .hero-subtitle-line {
    color: var(--color-gray-600);
    font-weight: 400;
    font-size: 0.7em;
    display: block;
    letter-spacing: 0.02em;
    margin-top: 0.2rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--color-gray-600);
    line-height: 1.78;
    margin-bottom: 2.25rem;
    max-width: 520px;
  }
  .hero-desc strong { color: var(--color-blue-900); font-weight: 700; }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .stat { display: flex; flex-direction: column; gap: 0.1rem; }
  .stat-n { font-size: 2rem; font-weight: 800; color: var(--color-blue-700); line-height: 1; }
  .stat-l { font-size: 0.73rem; color: var(--color-gray-500); text-transform: uppercase; letter-spacing: 0.06em; }
  .stat-sep { width: 1px; height: 36px; background: var(--color-gray-200); }

  /* Photo column */
  .hero-photo-col { display: flex; justify-content: center; }

  .hero-photo-wrap {
    position: relative;
    width: 100%;
    max-width: 440px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-photo {
    width: 100%;
    max-height: 680px;
    object-fit: contain;
    object-position: bottom center;
    display: block;
    /* drop-shadow preserves transparent PNG edges */
    filter: drop-shadow(0 0px 30px rgba(15, 52, 96, 0.15));
  }

  .hero-cred {
    position: absolute;
    bottom: 1.5rem;
    left: -2rem;
    background: var(--color-white);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow);
    max-width: 240px;
    border: 1px solid var(--color-gray-200);
  }

  .hero-cred-icon {
    width: 38px; height: 38px;
    background: var(--color-blue-50);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-blue-700);
    flex-shrink: 0;
  }
  .hero-cred-icon svg { width: 20px; height: 20px; }
  .hero-cred-title { font-size: 0.82rem; font-weight: 700; color: var(--color-blue-900); }
  .hero-cred-sub { font-size: 0.7rem; color: var(--color-accent); margin-top: 0.1rem; }

  .hero-online {
    position: absolute;
    top: 1.25rem;
    right: -1.25rem;
    background: var(--color-white);
    border-radius: 50px;
    padding: 0.4rem 0.85rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-gray-700);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-gray-200);
  }

  .online-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #25d366;
    animation: blink 1.5s infinite;
    flex-shrink: 0;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Bottom strip */
  .hero-strip {
    background: var(--color-blue-900);
    padding: 1.25rem 1.5rem;
    position: relative;
    z-index: 1;
  }

  .hero-strip-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .strip-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
    white-space: nowrap;
  }
  .strip-item svg { width: 18px; height: 18px; color: var(--color-blue-400); flex-shrink: 0; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; padding-top: 1rem; }
    .hero-photo-col { display: none; }
    .hero-title { font-size: 2.6rem; }
    .hero-strip-inner { gap: 1.5rem; }
    .stat-sep { display: none; }
    .hero-stats { gap: 1.25rem; }
  }

  @media (max-width: 480px) {
    .hero-title { font-size: 2rem; }
    .strip-item { font-size: 0.78rem; gap: 0.35rem; }
    .hero-strip-inner { gap: 1rem; }
  }
</style>
