---
// Services with REAL services provided by the user
const WA_NUMBER = '56981862444';

const services = [
  {
    id: 'presoterapia',
    title: 'Presoterapia',
    description: 'Tratamiento mediante compresión neumática secuencial que mejora la circulación linfática y venosa, reduce la retención de líquidos, combate la celulitis y favorece la recuperación muscular post-ejercicio.',
    tags: ['Circulación', 'Drenaje linfático', 'Anti-celulitis', 'Recuperación'],
    icon: 'zap',
    color: 'blue',
  },

  {
    id: 'compresas-calientes',
    title: 'Compresas Calientes',
    description: 'Aplicación de calor terapéutico que relaja la musculatura, reduce contracturas, mejora la elasticidad tisular y prepara el tejido para otras intervenciones kinesiológicas. Ideal para contracturas cervicales y lumbares.',
    tags: ['Relajación muscular', 'Contracturas', 'Cervicalgia', 'Lumbalgia'],
    icon: 'fire',
    color: 'orange',
  },
  {
    id: 'masaje-reductivo',
    title: 'Masaje Reductivo',
    description: 'Técnica de masaje profundo que estimula el metabolismo graso localizado, mejora el contorno corporal y potencia los resultados de otros tratamientos estéticos. Ideal para zonas de abdomen, caderas y muslos.',
    tags: ['Reductivo', 'Contorno corporal', 'Grasa localizada', 'Estético'],
    icon: 'star',
    color: 'blue',
  },
  {
    id: 'descarga-deportiva',
    title: 'Masaje y Descarga Deportiva',
    description: 'Masoterapia deportiva profunda orientada a la recuperación del deportista: descontractura muscular, liberación de puntos gatillo, mejora del rango articular y prevención de lesiones. Indicado post-competencia y post-entrenamiento.',
    tags: ['Deportistas', 'Descontractura', 'Recuperación', 'Prevención'],
    icon: 'sport',
    color: 'blue',
  },
  {
    id: 'ultrasonido-tens',
    title: 'Ultrasonido y TENS',
    description: 'Electroterapia de precisión: el ultrasonido terapéutico acelera la reparación tisular y reduce inflamación, mientras el TENS (estimulación nerviosa eléctrica transcutánea) ofrece alivio del dolor sin fármacos.',
    tags: ['Electroterapia', 'Dolor', 'Inflamación', 'Tejidos blandos'],
    icon: 'bolt',
    color: 'blue',
  },
  {
    id: 'postoperatorio',
    title: 'Rehabilitación Post-Operatoria',
    description: 'Acompañamiento kinesiológico integral después de cirugías tanto estéticas (liposucción, abdominoplastia) como ortopédicas y deportivas (artroscopias, reemplazos articulares). Recuperación segura y eficiente.',
    tags: ['Post-cirugía estética', 'Post-cirugía deportiva', 'Rehabilitación', 'Seguro'],
    icon: 'shield',
    color: 'blue',
  },
  {
    id: 'musculoesqueletico',
    title: 'Rehabilitación Musculoesquelética',
    description: 'Diagnóstico funcional y tratamiento integral de lesiones articulares, musculares y de columna vertebral. Programas de rehabilitación personalizados para devolverte la movilidad y calidad de vida.',
    tags: ['Columna', 'Articulaciones', 'Dolor crónico', 'Movilidad'],
    icon: 'bone',
    color: 'blue',
  },
];
---

<section id="servicios" class="services bg-gray">
  <div class="container">
    <div class="services-header reveal">
      <span class="section-label">Servicios</span>
      <h2 class="section-title">¿En qué te puedo ayudar?</h2>
      <div class="divider"></div>
      <p class="section-subtitle">
        Ofrezco tratamientos kinesiológicos con equipos de última generación, desde la rehabilitación
        musculoesquelética y deportiva hasta procedimientos de kinesiología estética.
      </p>
    </div>

    <!-- Featured highlight: Ondas de choque with real image -->
      <div class="featured-service-banner reveal">
        <div class="fsb-image">
          <img src="/ondas-de-choque.png" alt="Tratamiento de Ondas de Choque para Espolón Calcáneo — Víctor Gallardo" />
        </div>
        <div class="fsb-body">
          <span class="fsb-badge">Tratamiento destacado</span>
          <h3 class="fsb-title">Terapia de Ondas de Choque</h3>
          <p class="fsb-desc">Tratamiento no invasivo de alta efectividad para espolón calcáneo, tendinopatías, fascitis plantar y calcificaciones. Resultados clínicamente comprobados en pocas sesiones, sin cirugía ni recuperación prolongada.</p>
          <div class="fsb-tags">
            <span class="tag">Espolón calcáneo</span>
            <span class="tag">No invasivo</span>
            <span class="tag">Recuperación rápida</span>
            <span class="tag">Fascitis plantar</span>
          </div>
          <a
            href={`https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20me%20interesa%20el%20tratamiento%20de%20Ondas%20de%20Choque.%20¿Me%20puede%20dar%20más%20información?`}
            target="_blank" rel="noopener"
            class="btn-wa" id="cta-ondas-featured"
          >
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Consultar este tratamiento
          </a>
        </div>
      </div>

    <div class="services-grid">
      {services.map((svc, i) => (
        <div class="service-card card reveal" id={`service-${svc.id}`} style={`transition-delay:${(i%4)*0.08}s`}>
          <div class={`service-icon service-icon--${svc.color}`}>
            {svc.icon === 'zap' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>}
            {svc.icon === 'wave' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.75h.008v.008H3.75V9.75zm0 5.25h.008v.008H3.75v-.008zM7.5 7.5h.008v.008H7.5V7.5zm0 9h.008v.008H7.5v-.008zm3.75-11.25h.008v.008H11.25V5.25zm0 13.5h.008v.008H11.25v-.008zm3.75-11.25h.008v.008H15V7.5zm0 9h.008v.008H15v-.008zm3.75-6.75h.008v.008H18.75V9.75zm0 5.25h.008v.008H18.75v-.008z"/></svg>}
            {svc.icon === 'fire' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z"/></svg>}
            {svc.icon === 'star' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>}
            {svc.icon === 'sport' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 10-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 013.15 0v1.5m-3.15 0l.075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 013.15 0V15M6.9 7.575a1.575 1.575 0 10-3.15 0v8.175a6.75 6.75 0 006.75 6.75h2.018a5.25 5.25 0 003.712-1.538l1.732-1.732a5.25 5.25 0 001.538-3.712l-.001-1.286a3.75 3.75 0 00-.369-1.61l-2.619-5.238a1.575 1.575 0 10-2.81 1.408l1.261 2.523"/></svg>}
            {svc.icon === 'bolt' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M11.412 15.655L9.75 21.75l3.745-4.012M9.257 13.5H3.75l2.659-2.849m2.048-2.194L14.25 2.25 12 10.5h8.25l-4.707 5.043M6.457 19.061c-1.06 1.139-1.61 1.861-1.61 1.861"/></svg>}
            {svc.icon === 'shield' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>}
            {svc.icon === 'bone' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5"/></svg>}
          </div>

          <h3 class="service-title">{svc.title}</h3>
          <p class="service-desc">{svc.description}</p>

          <div class="service-tags">
            {svc.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>

          <a
            href={`https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20me%20interesa%20el%20servicio%20de%20${encodeURIComponent(svc.title)}.%20¿Podría%20darme%20más%20información?`}
            target="_blank" rel="noopener"
            class="service-cta"
            id={`cta-${svc.id}`}
          >
            Consultar por este tratamiento →
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding-bottom: 5.5rem; }
  .services-header { margin-bottom: 3rem; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .service-card {
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: 0.85rem;
    cursor: default;
  }

  .service-icon {
    width: 50px; height: 50px;
    border-radius: 13px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .service-icon--blue { background: var(--color-blue-50); color: var(--color-blue-700); border: 1px solid var(--color-blue-100); }
  .service-icon--orange { background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }
  .service-icon svg { width: 24px; height: 24px; }

  .service-title { font-size: 0.98rem; font-weight: 700; color: var(--color-blue-900); line-height: 1.3; }
  .service-desc { font-size: 0.85rem; color: var(--color-gray-600); line-height: 1.7; flex: 1; }

  .service-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tag {
    font-size: 0.68rem; font-weight: 600;
    color: var(--color-blue-700);
    background: var(--color-blue-50);
    border: 1px solid var(--color-blue-100);
    padding: 0.2rem 0.55rem;
    border-radius: 20px;
  }

  .service-cta {
    font-size: 0.8rem; font-weight: 700; color: var(--color-accent);
    transition: color 0.2s ease, letter-spacing 0.2s ease;
    margin-top: 0.25rem; text-decoration: none;
  }
  .service-cta:hover { color: var(--color-blue-900); }

  @media (max-width: 1000px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px)  { .services-grid { grid-template-columns: 1fr; } .service-card { padding: 1.5rem; } }

  /* Featured banner — ondas de choque */
  .featured-service-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: 2rem;
    border: 1px solid var(--color-gray-200);
  }

  .fsb-image {
    overflow: hidden;
    max-height: 340px;
  }
  .fsb-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .fsb-body {
    background: var(--color-white);
    padding: 2.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    justify-content: center;
  }

  .fsb-badge {
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--color-blue-700);
    background: var(--color-blue-100);
    padding: 0.25rem 0.75rem; border-radius: 20px;
    width: fit-content;
  }

  .fsb-title { font-size: 1.5rem; font-weight: 800; color: var(--color-blue-900); }
  .fsb-desc { font-size: 0.95rem; color: var(--color-gray-600); line-height: 1.7; }
  .fsb-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  @media (max-width: 700px) {
    .featured-service-banner { grid-template-columns: 1fr; }
    .fsb-image { max-height: 220px; }
    .fsb-body { padding: 1.5rem; }
  }
</style>
