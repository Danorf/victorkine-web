          </a>
          <a href={WA_LINK} target="_blank" rel="noopener" aria-label="WhatsApp" class="fb-social-link fb-social-link--wa">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Servicios</h4>
        <ul class="footer-links">
          <li><a href="#servicios">Presoterapia</a></li>
          <li><a href="#servicios">Ondas de Choque</a></li>
          <li><a href="#servicios">Masaje Reductivo</a></li>
          <li><a href="#servicios">Descarga Deportiva</a></li>
          <li><a href="#servicios">Ultrasonido y TENS</a></li>
          <li><a href="#servicios">Post-Operatorios</a></li>
          <li><a href="#servicios">Rehabilitación Musculoesquelética</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Contacto</h4>
        <ul class="footer-contact-list">
          <li>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <a href={WA_LINK} target="_blank" rel="noopener">+56 9 8186 2444</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z"/></svg>
            <span>Las Condes · La Reina · Vitacura<br/>Providencia · Ñuñoa</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Mar–Jue 14:00–20:00 (KW)<br/>Resto de la semana 09:00–20:00</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© {new Date().getFullYear()} Víctor Gallardo — Kinesiólogo. Todos los derechos reservados.</span>
      <span class="footer-domain">spaequipos.cl</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-blue-900); color: rgba(255,255,255,0.75); }

  .footer-top { padding: 4rem 1.5rem 3rem; }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 3rem;
  }

  /* Brand column */
  .fb-logo {
    display: flex; align-items: center; gap: 0.75rem;
    margin-bottom: 1.1rem;
  }
  .fb-icon {
    width: 42px; height: 42px;
    background: linear-gradient(135deg, var(--color-blue-500), var(--color-blue-700));
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    color: #fff; flex-shrink: 0;
  }
  .fb-icon svg { width: 22px; height: 22px; }
  .fb-name { font-size: 0.95rem; font-weight: 700; color: #fff; }
  .fb-title { font-size: 0.65rem; color: var(--color-blue-400); text-transform: uppercase; letter-spacing: 0.07em; margin-top: 0.1rem; }

  .fb-desc {
    font-size: 0.88rem; line-height: 1.7;
    color: rgba(255,255,255,0.55); margin-bottom: 1.5rem;
  }

  .fb-social { display: flex; gap: 0.5rem; }
  .fb-social-link {
    width: 36px; height: 36px; border-radius: 9px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.6);
    transition: all 0.2s; text-decoration: none;
  }
  .fb-social-link:hover { background: rgba(255,255,255,0.14); color: #fff; }
  .fb-social-link--wa:hover { background: rgba(37,211,102,0.2); border-color: rgba(37,211,102,0.3); color: #25d366; }
  .fb-social-link svg { width: 16px; height: 16px; }

  /* Link columns */
  .footer-col {}
  .footer-heading {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: rgba(255,255,255,0.4);
    margin-bottom: 1.1rem;
  }

  .footer-links { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-links a {
    font-size: 0.87rem; color: rgba(255,255,255,0.65);
    transition: color 0.2s; text-decoration: none;
  }
  .footer-links a:hover { color: #fff; }

  .footer-contact-list { list-style: none; display: flex; flex-direction: column; gap: 0.85rem; }
  .footer-contact-list li { display: flex; align-items: flex-start; gap: 0.6rem; }
  .footer-contact-list svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; color: var(--color-blue-400); }
  .footer-contact-list span, .footer-contact-list a {
    font-size: 0.85rem; color: rgba(255,255,255,0.65); line-height: 1.5;
    text-decoration: none; transition: color 0.2s;
  }
  .footer-contact-list a:hover { color: #fff; }

  /* Bottom bar */
  .footer-bottom {
    background: rgba(0,0,0,0.25);
    padding: 1.1rem 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .footer-bottom-inner {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.78rem; color: rgba(255,255,255,0.35);
    flex-wrap: wrap; gap: 0.5rem;
  }
  .footer-domain { font-weight: 600; color: var(--color-blue-400); }

  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
