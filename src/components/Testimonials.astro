---
const WA_NUMBER = '56981862444';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20quisiera%20agendar%20una%20consulta.`;

const testimonials = [
  {
    name: 'Claudia M.',
    comuna: 'Las Condes',
    service: 'Ondas de Choque',
    text: 'Llevaba meses con dolor de talón insoportable. Tres sesiones de ondas de choque con Víctor y el cambio fue radical. Volvió a ser la persona de siempre — profesional, paciente y muy bien explicado todo el proceso.',
    stars: 5,
    initial: 'C',
  },
  {
    name: 'Rodrigo T.',
    comuna: 'Providencia',
    service: 'Descarga Deportiva',
    text: 'Entreno running y después de cada competencia recurro a Víctor para la recuperación. La descarga muscular que hace es de primer nivel. Más de 3 años siendo su paciente y no cambiaría nada.',
    stars: 5,
    initial: 'R',
  },
  {
    name: 'Patricia V.',
    comuna: 'Vitacura',
    service: 'Post-Operatorio',
    text: 'Me operé de liposucción y seguí el plan de rehabilitación con Víctor. Los resultados superaron mis expectativas. Muy dedicado, puntual y la atención es completamente personalizada.',
    stars: 5,
    initial: 'P',
  },
  {
    name: 'Jorge A.',
    comuna: 'Ñuñoa',
    service: 'Rehabilitación Musculoesquelética',
    text: 'Tenía una contractura lumbar crónica que me impedía trabajar cómodamente. Víctor diseñó un plan específico para mí y en pocas semanas recuperé la movilidad. Muy recomendable.',
    stars: 5,
    initial: 'J',
  },
  {
    name: 'Marcela S.',
    comuna: 'La Reina',
    service: 'Presoterapia',
    text: 'Empecé con presoterapia para la retención de líquidos y en pocas sesiones noté una diferencia increíble. El ambiente es muy profesional y Víctor siempre está dispuesto a resolver dudas.',
    stars: 5,
    initial: 'M',
  },
  {
    name: 'Andrés F.',
    comuna: 'Las Condes',
    service: 'TENS y Ultrasonido',
    text: 'Después de años con dolor de hombro, Víctor fue el primero que realmente entendió el problema. El tratamiento con ultrasonido fue muy efectivo. Profesional serio y con mucha experiencia.',
    stars: 5,
    initial: 'A',
  },
];
---

<section id="testimonios" class="testimonials">
  <div class="container">
    <div class="test-header reveal">
      <span class="section-label">Testimonios</span>
      <h2 class="section-title">Lo que dicen mis pacientes</h2>
      <div class="divider"></div>
      <p class="section-subtitle">
        La satisfacción de mis pacientes es el reflejo más honesto de mi trabajo.
        Más de 40 años construyendo confianza, una recuperación a la vez.
      </p>
    </div>

    <!-- Stats bar -->
    <div class="test-stats reveal">
      <div class="ts-item">
        <span class="ts-n">+40</span>
        <span class="ts-l">Años de experiencia</span>
      </div>
      <div class="ts-sep"></div>
      <div class="ts-item">
        <div class="ts-stars">★★★★★</div>
        <span class="ts-l">Calificación promedio</span>
      </div>
      <div class="ts-sep"></div>
      <div class="ts-item">
        <span class="ts-n">100%</span>
        <span class="ts-l">Atención personalizada</span>
      </div>
    </div>

    <div class="test-grid">
      {testimonials.map((t, i) => (
        <div class="test-card card reveal" style={`transition-delay:${(i%3)*0.1}s`}>
          <div class="test-top">
            <div class="test-avatar">{t.initial}</div>
            <div class="test-meta">
              <span class="test-name">{t.name}</span>
              <span class="test-location">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z"/>
                </svg>
                {t.comuna}
              </span>
            </div>
            <div class="test-stars">{'★'.repeat(t.stars)}</div>
          </div>

          <blockquote class="test-quote">"{t.text}"</blockquote>

          <div class="test-service">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {t.service}
          </div>
        </div>
      ))}
    </div>

    <!-- CTA bottom -->
    <div class="test-cta reveal">
      <p>¿Listo para comenzar tu recuperación?</p>
      <a href={WA_LINK} target="_blank" rel="noopener" class="btn-wa" id="cta-wa-testimonials">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Agendar mi primera consulta
      </a>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: linear-gradient(180deg, var(--color-white) 0%, var(--color-blue-50) 100%);
    padding-bottom: 5rem;
  }
  .test-header { margin-bottom: 2.5rem; }

  /* Stats bar */
  .test-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    margin-bottom: 3rem;
    box-shadow: var(--shadow-sm);
    flex-wrap: wrap;
  }
  .ts-item { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .ts-n { font-size: 1.75rem; font-weight: 800; color: var(--color-blue-700); line-height: 1; }
  .ts-l { font-size: 0.72rem; color: var(--color-gray-500); text-transform: uppercase; letter-spacing: 0.08em; }
  .ts-stars { font-size: 1.1rem; color: #f59e0b; letter-spacing: 0.05em; }
  .ts-sep { width: 1px; height: 40px; background: var(--color-gray-200); }

  /* Cards grid */
  .test-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .test-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-white);
  }

  .test-top {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .test-avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-blue-700), var(--color-blue-500));
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1rem; color: #fff;
    flex-shrink: 0;
  }

  .test-meta {
    display: flex; flex-direction: column; gap: 0.15rem; flex: 1;
  }
  .test-name { font-size: 0.9rem; font-weight: 700; color: var(--color-blue-900); }
  .test-location {
    display: flex; align-items: center; gap: 0.25rem;
    font-size: 0.72rem; color: var(--color-gray-400);
  }
  .test-location svg { color: var(--color-accent); flex-shrink: 0; }

  .test-stars { font-size: 0.85rem; color: #f59e0b; letter-spacing: 0.05em; margin-left: auto; }

  .test-quote {
    font-size: 0.9rem;
    color: var(--color-gray-600);
    line-height: 1.75;
    font-style: italic;
    flex: 1;
    margin: 0;
    position: relative;
    padding-left: 1rem;
    border-left: 3px solid var(--color-blue-100);
  }

  .test-service {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 0.72rem; font-weight: 700;
    color: var(--color-blue-700);
    text-transform: uppercase; letter-spacing: 0.07em;
  }
  .test-service svg { color: var(--color-accent); flex-shrink: 0; }

  /* Bottom CTA */
  .test-cta {
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
  }
  .test-cta p {
    font-size: 1.1rem; font-weight: 600; color: var(--color-blue-900);
  }

  @media (max-width: 900px) { .test-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) {
    .test-grid { grid-template-columns: 1fr; }
    .test-stats { gap: 1.5rem; }
    .ts-sep { display: none; }
  }
</style>
