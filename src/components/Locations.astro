---
// Location & Hours section – real data
const WA_NUMBER = '56981862444';
const KW_WA = `https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20quiero%20agendar%20en%20KinesicWork%20(martes%20o%20jueves).`;
const PARTICULAR_WA = `https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20quiero%20coordinar%20una%20atención%20particular.`;
---

<section id="donde-atiendo" class="locations">
  <div class="container">
    <div class="locations-header reveal">
      <span class="section-label">Dónde y cuándo atiendo</span>
      <h2 class="section-title">Cerca de ti en Santiago</h2>
      <div class="divider"></div>
      <p class="section-subtitle">
        Atiendo en las comunas del sector oriente de Santiago y también de forma particular, coordinando directamente contigo.
      </p>
    </div>

    <div class="locations-grid">
      <!-- KinesicWork card -->
      <div class="loc-card loc-card--featured card reveal">
        <div class="loc-badge">Centro Clínico</div>
        <div class="loc-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
          </svg>
        </div>
        <h3 class="loc-name">KinesicWork</h3>
        <div class="loc-address">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z"/>
          </svg>
          Av. Larraín 6642, Of. 214<br/>La Reina, Santiago
        </div>

        <div class="loc-hours">
          <div class="hours-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Horario de atención
          </div>
          <div class="hours-days">
            <div class="day-row">
              <span class="day">Martes y Jueves</span>
              <span class="time">14:00 – 20:00 hrs</span>
            </div>
          </div>
        </div>

        <div class="loc-link-row">
          <a href="https://kinesicwork.cl" target="_blank" rel="noopener" class="loc-web">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
            </svg>
            kinesicwork.cl
          </a>
        </div>

        <a href={KW_WA} target="_blank" rel="noopener" class="btn-wa" id="cta-wa-kw" style="justify-content:center;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Agendar en KinesicWork
        </a>
      </div>

      <!-- Particular card -->
      <div class="loc-card card reveal" style="transition-delay:0.1s">
        <div class="loc-icon loc-icon--light">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
          </svg>
        </div>
        <h3 class="loc-name">Atención Particular</h3>
        <div class="loc-address">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0115 0z"/>
          </svg>
          Las Condes · La Reina · Vitacura<br/>Providencia · Ñuñoa
        </div>

        <div class="loc-hours">
          <div class="hours-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Horario de atención
          </div>
          <div class="hours-days">
            <div class="day-row">
              <span class="day">Lun, Mié, Vie, Sáb, Dom</span>
              <span class="time">09:00 – 20:00 hrs</span>
            </div>
            <p class="hours-note">Según disponibilidad y coordinación directa con el paciente.</p>
          </div>
        </div>

        <a href={PARTICULAR_WA} target="_blank" rel="noopener" class="btn-primary" id="cta-wa-particular" style="justify-content:center;">
          Coordinar atención particular
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Comunas strip -->
      <div class="comunas-strip card reveal" style="transition-delay:0.2s">
        <div class="comunas-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
          </svg>
        </div>
        <div class="comunas-text">
          <h4>Sector oriente de Santiago</h4>
          <p>Atención presencial en cinco comunas del sector oriente de Santiago. Consulta disponibilidad para tu zona.</p>
          <div class="comunas-list">
            {['Las Condes', 'La Reina', 'Vitacura', 'Providencia', 'Ñuñoa'].map(c => (
              <span class="comuna-pill">{c}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .locations { background: var(--color-white); }
  .locations-header { margin-bottom: 3rem; }

  .locations-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1.5rem;
  }

  .loc-card {
    padding: 2rem;
    display: flex; flex-direction: column; gap: 1.1rem;
  }

  .loc-card--featured {
    border-color: rgba(25,118,210,0.2);
    background: linear-gradient(160deg, var(--color-blue-50) 0%, var(--color-white) 100%);
  }

  .loc-badge {
    font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--color-blue-700);
    background: var(--color-blue-100);
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    width: fit-content;
  }

  .loc-icon {
    width: 50px; height: 50px;
    background: linear-gradient(135deg, var(--color-blue-700), var(--color-blue-500));
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
  }
  .loc-icon--light {
    background: var(--color-blue-50);
    color: var(--color-blue-700);
    border: 1px solid var(--color-blue-100);
  }
  .loc-icon svg { width: 26px; height: 26px; }

  .loc-name { font-size: 1.25rem; font-weight: 700; color: var(--color-blue-900); }

  .loc-address {
    display: flex; align-items: flex-start; gap: 0.4rem;
    font-size: 0.9rem; color: var(--color-gray-600); line-height: 1.5;
  }
  .loc-address svg { flex-shrink: 0; margin-top: 2px; color: var(--color-accent); }

  .loc-hours { background: var(--color-gray-50); border-radius: var(--radius); padding: 1rem 1.1rem; }

  .hours-label {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--color-gray-500); margin-bottom: 0.65rem;
  }
  .hours-label svg { color: var(--color-accent); }

  .day-row {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 0.25rem;
  }
  .day { font-size: 0.88rem; font-weight: 600; color: var(--color-blue-900); }
  .time { font-size: 0.88rem; font-weight: 700; color: var(--color-accent); }
  .hours-note { font-size: 0.78rem; color: var(--color-gray-400); margin-top: 0.5rem; }

  .loc-link-row { display: flex; align-items: center; gap: 0.5rem; }

  .loc-web {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.82rem; font-weight: 600; color: var(--color-accent);
    text-decoration: none; transition: color 0.2s;
  }
  .loc-web:hover { color: var(--color-blue-900); }

  /* Comunas strip – spans full width */
  .comunas-strip {
    grid-column: 1 / -1;
    padding: 1.75rem 2rem;
    display: flex; align-items: flex-start; gap: 1.5rem;
    background: var(--color-blue-900);
    border-color: transparent;
  }
  .comunas-strip:hover { transform: none; }

  .comunas-icon {
    width: 52px; height: 52px; flex-shrink: 0;
    background: rgba(255,255,255,0.1);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-blue-400);
  }
  .comunas-icon svg { width: 26px; height: 26px; }

  .comunas-text h4 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 0.35rem; }
  .comunas-text p { font-size: 0.88rem; color: rgba(255,255,255,0.65); margin-bottom: 1rem; }

  .comunas-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .comuna-pill {
    font-size: 0.8rem; font-weight: 600;
    color: var(--color-blue-400);
    background: rgba(66,165,245,0.12);
    border: 1px solid rgba(66,165,245,0.25);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
  }

  @media (max-width: 700px) {
    .locations-grid { grid-template-columns: 1fr; }
    .comunas-strip { flex-direction: column; gap: 1rem; }
    .comunas-strip { grid-column: 1; }
  }
</style>
