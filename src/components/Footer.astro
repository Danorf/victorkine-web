---
const WA_NUMBER = '56981862444';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hola%20Víctor%2C%20quisiera%20agendar%20una%20consulta.`;
const EMAIL = 'victor.gallardo@spaequipos.cl';
const INSTAGRAM = 'https://www.instagram.com/victorkine_integral/';
---

